# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# sauvegarde locale avant migration Sanity
/backup

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# payload uploads
/public/media/**
!/public/media/.gitkeep

# giant migration artefacts: never commit generated export files
/public/sql/output/**
/public/sql/articles.xml
/migration-report.md
