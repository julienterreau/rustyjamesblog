NEXT_PUBLIC_SITE_URL=https://rustyjamesblog.link

# Newsletter. RESEND_FROM est l'adresse d'expéditeur vérifiée dans Resend.
# RESEND_SEGMENT_ID est optionnel : sans lui, le segment « Abonnés » est réutilisé ou créé.
RESEND_API_KEY=
RESEND_FROM=
RESEND_SEGMENT_ID=

# Sanity. Le jeton d'écriture sert à l'inscription des abonnés et aux scripts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
