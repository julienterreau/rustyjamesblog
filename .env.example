NEXT_PUBLIC_SITE_URL=https://rustyjamesblog.link

# Newsletter. RESEND_FROM est l'adresse d'expéditeur vérifiée dans Resend.
# RESEND_SEGMENT_ID est optionnel : sans lui, le segment « Abonnés » est réutilisé ou créé.
RESEND_API_KEY=
RESEND_FROM=
RESEND_SEGMENT_ID=

# Sanity. Le jeton d'écriture sert à l'inscription des abonnés et aux scripts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Visites anonymes. VISITOR_SALT est une longue chaîne aléatoire : elle change le
# hash quotidien visiteur, et l'adresse IP n'est jamais stockée.
# GEOIP_DB_PATH pointe vers GeoLite2-City.mmdb (voir scripts/update-geolite.mjs).
# MAXMIND_LICENSE_KEY sert uniquement à télécharger cette base, une fois par mois.
VISITOR_SALT=
GEOIP_DB_PATH=data/GeoLite2-City.mmdb
MAXMIND_LICENSE_KEY=
